<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Recognition.Core\Recognition.Core.csproj" />
    <ProjectReference Include="..\Recognition.Infrastructure\Recognition.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>true</IsPackable>
    <PackageId>GenericRecognition.Workbench.Wpf</PackageId>
    <Description>Reusable WPF UI for the generic recognition workbench.</Description>
    <PackageTags>ocr;recognition;wpf;workbench</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
