<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Recognition.Core\Recognition.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="PaddleOCRSharp" Version="6.2.0" />
    <PackageReference Include="Paddle.Runtime.win_x64" Version="3.3.0.1" />
    <PackageReference Include="System.Management" Version="9.0.8" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Drawing" Version="5.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>true</IsPackable>
    <PackageId>GenericRecognition.Workbench.Infrastructure</PackageId>
    <Description>Infrastructure implementations for the generic recognition workbench.</Description>
    <PackageTags>ocr;recognition;opencv;tesseract;paddleocr</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\PACKAGE_README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\GenericRecognition.Workbench.Infrastructure.targets"
          Pack="true"
          PackagePath="buildTransitive\GenericRecognition.Workbench.Infrastructure.targets"
          Visible="false" />
  </ItemGroup>

</Project>
