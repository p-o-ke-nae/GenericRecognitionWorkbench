<Project>
  <PropertyGroup>
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(Version)' == ''">local</VersionSuffix>
    <Authors>o_leg</Authors>
    <Company>p-o-ke-nae</Company>
    <Copyright>Copyright (c) p-o-ke-nae</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/p-o-ke-nae/GenericRecognitionWorkbench</PackageProjectUrl>
    <RepositoryUrl>https://github.com/p-o-ke-nae/GenericRecognitionWorkbench.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
